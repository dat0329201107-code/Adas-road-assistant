# ==============================================================================
# VisionDrive AI - Environment Configuration Example
# Đề tài 6: Notification for Driver based on type of road
# ==============================================================================

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=info

# Machine Learning Model Configuration
MODEL_PATH=models/vietnam_road_classifier.pt
MODEL_DEVICE=auto
# Options: auto, cuda, cpu

# Warning & Smoothing Hyperparameters
SMOOTHING_ALPHA=0.65
HYSTERESIS_DELTA=0.08
MIN_CONFIDENCE_THRESHOLD=0.55
WARMUP_FRAMES=3
DEFAULT_CAUTION_MARGIN_KMH=5

# Speed Rules Dataset
SPEED_RULES_PATH=rules/speed_rules.json

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
